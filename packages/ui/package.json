{
  "name": "@harnessd/ui",
  "version": "0.0.0",
  "description": "The harnessd web UI, built by Vite and served by the daemon.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "vite",
    "demo": "node scripts/demo.ts",
    "typecheck": "tsc --noEmit && tsc -p app/tsconfig.json && tsc -p tsconfig.scripts.json",
    "test": "node --test \"src/**/*.test.ts\" \"app/src/**/*.test.ts\""
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@harnessd/daemon": "workspace:*",
    "@harnessd/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.38.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
