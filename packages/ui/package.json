{
  "name": "@harnessd/ui",
  "version": "0.0.0",
  "description": "The harnessd web UI, built by Vite and served by the daemon.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "vite",
    "demo": "node scripts/demo.ts",
    "typecheck": "tsc --noEmit && tsc -p app/tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\" \"app/src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vite": "^8.3.8",
    "@harnessd/daemon": "workspace:*",
    "@harnessd/shared": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
