{
  "name": "@harnessd/cli",
  "version": "0.0.0",
  "description": "The harnessd command line.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashwinYardi/harnessd.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-pack.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "bin": {
    "harnessd": "./dist/bin.js"
  },
  "dependencies": {
    "@harnessd/daemon": "workspace:*",
    "@harnessd/shared": "workspace:*"
  }
}
