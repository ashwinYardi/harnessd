{
  "name": "@harnessd/daemon",
  "version": "0.0.0",
  "description": "The harnessd daemon: scheduler, harness adapters, worktrees and integrations.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "qa-browser": "./dist/qa-browser/qa-browser.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-qa-browser-bin.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@harnessd/shared": "workspace:*",
    "playwright-core": "^1.49.0",
    "smol-toml": "^1.9.1",
    "undici": "^7.30.2"
  }
}
