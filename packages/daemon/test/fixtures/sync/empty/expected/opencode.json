{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "deny",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "harnessd_memory_*": "allow",
    "bash": {
      "*": "allow",
      "git push": "deny",
      "git push *": "deny"
    },
    "external_directory": "deny",
    "question": "deny",
    "doom_loop": "deny"
  },
  "websearch": {
    "provider": "random"
  },
  "mcp": {
    "harnessd-memory": {
      "type": "local",
      "command": [
        "harnessd",
        "mcp",
        "memory"
      ],
      "enabled": true
    }
  }
}
